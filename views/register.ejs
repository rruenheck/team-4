<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
    <!-- Swap 4xx/5xx responses too, so error messages from the server are shown -->
    <meta
      name="htmx-config"
      content='{"responseHandling":[{"code":"204","swap":false},{"code":"[2345]..","swap":true}]}'
    />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body class="min-h-screen p-4 sm:p-8">
    <main class="max-w-md mx-auto">
      <h1 class="text-2xl font-bold text-center mb-6">Register</h1>

      <form
        id="register-form"
        action="/register"
        method="POST"
        hx-post="/register"
        hx-target="#message"
        hx-swap="innerHTML"
        class="flex flex-col gap-3 bg-white rounded-lg shadow-md p-6"
      >
        <label for="email" class="font-medium">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="w-full border border-gray-300 rounded p-2 focus:border-blue-600"
        />

        <label for="password" class="font-medium">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          class="w-full border border-gray-300 rounded p-2 focus:border-blue-600"
        />

        <button type="submit" class="bg-blue-700 text-white rounded px-4 py-2 hover:bg-blue-800">Register</button>
      </form>

      <p id="message" aria-live="polite" class="mt-4 text-center"></p>

      <p class="mt-4 text-center"><a href="/login" class="text-blue-700 hover:underline">Back to login</a></p>
      <p class="mt-2 text-center"><a href="/home" class="text-blue-700 hover:underline">Home</a></p>
    </main>
  </body>
</html>
