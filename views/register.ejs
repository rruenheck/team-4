<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
    <!-- Swap 4xx/5xx responses too, so error messages from the server are shown -->
    <meta
      name="htmx-config"
      content='{"responseHandling":[{"code":"204","swap":false},{"code":"[2345]..","swap":true}]}'
    />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body>
    <h1>Register</h1>

    <form
      id="register-form"
      action="/register"
      method="POST"
      hx-post="/register"
      hx-target="#message"
      hx-swap="innerHTML"
    >
      <label for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      />

      <label for="password">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
      />

      <button type="submit">Register</button>
    </form>

    <p id="message" aria-live="polite"></p>

    <p><a href="/login">Back to login</a></p>
    <p><a href="/home">Home</a></p>
  </body>
</html>
