<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="min-h-screen p-4 sm:p-8">
    <main class="max-w-md mx-auto">
      <h1 class="text-2xl font-bold text-center mb-6">Login</h1>

      <form
        id="login-form"
        action="/login"
        method="POST"
        class="flex flex-col gap-3 bg-white rounded-lg shadow-md p-6"
      >
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="w-full border border-gray-300 rounded p-2 focus:border-blue-600"
        />

        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          class="w-full border border-gray-300 rounded p-2 focus:border-blue-600"
        />

        <button type="submit" class="bg-blue-700 text-white rounded px-4 py-2 hover:bg-blue-800">Login</button>
      </form>

    <p id="message" class="mt-4 text-center"></p>

    <script>
      const form = document.getElementById("login-form");
      const message = document.getElementById("message");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const email = document.getElementById("email").value;
        const password = document.getElementById("password").value;

        try {
          const response = await fetch("/login", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ email, password }),
          });

          const data = await response.json();

          if (response.ok) {
            window.location.href = "/account";
          } else {
            message.textContent = data.error || "Login failed";
            message.style.color = "red";
          }
        } catch (err) {
          message.textContent = "Could not connect to the server";
          message.style.color = "red";
        }
      });
    </script>

    <p class="mt-4 text-center">
        Need an account?
        <a href="/register" class="text-blue-700 hover:underline">Register</a>
      </p>
      <p class="mt-2 text-center">
        <a href="/home" class="text-blue-700 hover:underline">Home</a>
      </p>
    </main>
  </body>
</html>
